# 운영 배포용 환경변수 예시. 복사해서 .env로 쓰고(.env는 Git에 올리지 않는다) CHANGE_ME를 실제 값으로 바꾼다.

# 이미지 (전체 참조: 레지스트리/저장소:태그). 배포 워크플로가 태그를 갱신한다.
APP_IMAGE=CHANGE_ME
FRONT_IMAGE=CHANGE_ME

# DB (TimescaleDB)
DB_USERNAME=ove
DB_PASSWORD=CHANGE_ME

# JWT 서명 키. 32바이트 이상 무작위 문자열 (openssl rand -base64 48)
JWT_SECRET=CHANGE_ME

# 프론트 origin (CloudFront 주소). 쉼표로 여러 개 가능, 슬래시 없이
CORS_ALLOWED_ORIGINS=https://CHANGE_ME.cloudfront.net

# 코인 시세 수집기
COLLECTOR_ENABLED=true
COLLECTOR_SYMBOLS=KRW-BTC,KRW-ETH,KRW-XRP

# AI 모델 서버 연동 (#56 머지 후 유효). 터널 방식은 docs/deploy-aws.md 참고
MODEL_ENABLED=false
MODEL_BASE_URL=http://host.docker.internal:8000
MODEL_API_KEY=

# 스키마 정책 (Flyway 도입 전까지 update)
DDL_AUTO=update

# ============================================================================
# 키움 주식 수집 (발표 기간에만, 기본은 꺼짐)
#   !! 경고 !!
#   - 키움 API 약관상 시세의 제3자 제공이 금지되어 있다. 개인 키로 발표 시연을 하는 용도로만 쓰고,
#     발표 기간에만 켠다. 끝나면 반드시 원복한다: KIWOOM_ENABLED=false, SPRING_PROFILES_ACTIVE=prod
#   - 키와 시크릿은 서버의 .env에만 둔다(chmod 600 .env). Git, 채팅, 문서, 로그에 절대 넣지 않는다.
#   - 키움 수집기는 prod 프로필이면 기동을 거부한다. 켜려면 프로필을 prod가 아닌 값(예: demo)으로 바꿔야 한다.
#   - 프로필이 prod가 아니면 /api/demo/stocks/{code}/price 등이 로그인 없이 공개된다(시연용 엔드포인트).
#   - Swagger UI·API 문서는 compose에 고정된 SWAGGER_UI_ENABLED=false, API_DOCS_ENABLED=false가 그대로 유지된다.
#
# SPRING_PROFILES_ACTIVE=demo
# KIWOOM_ENABLED=true
# KIWOOM_APP_KEY=
# KIWOOM_APP_SECRET=
# KIWOOM_SYMBOLS=005930
# ============================================================================

# 아래 값은 compose에 고정되어 있어 여기서 바꿀 수 없다:
#   AUTH_COOKIE_SECURE=true, SWAGGER_UI_ENABLED=false, API_DOCS_ENABLED=false,
#   SERVER_FORWARD_HEADERS_STRATEGY=framework
# 아래 값은 기본이 안전한 값이며 위 키움 절차로만 바꾼다: SPRING_PROFILES_ACTIVE(prod), KIWOOM_ENABLED(false)
